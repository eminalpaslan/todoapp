# Gercek degerleri buraya degil, .env dosyasina yaz. Bu dosya sadece ornek/sablon.

# Backend API adresi. Hangi ortamda calistirdigina gore degisir:
# - Web (npm run web)           -> http://localhost:8001
# - Android emulator             -> http://10.0.2.2:8001 (emulatorun host'u gorme adresi)
# - Fiziksel cihaz (Expo Go)     -> bilgisayarin LAN IP'si, ornek http://192.168.1.23:8001
EXPO_PUBLIC_API_URL=http://localhost:8001
