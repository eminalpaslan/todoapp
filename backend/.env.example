# Gerçek değerleri buraya değil, .env dosyasına yaz. Bu dosya sadece örnek/şablon.

# docker-compose.yml bu değerleri Postgres container'ını oluştururken kullanır
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=todo_db

# FastAPI uygulamasının bağlanacağı adres (yukarıdaki POSTGRES_* değerleriyle eşleşmeli)
DATABASE_URL=postgresql+asyncpg://todo_user:change_this_password@localhost:5432/todo_db

JWT_SECRET_KEY=change_this_to_a_random_32_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
